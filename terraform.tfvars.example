# Copie este arquivo para terraform.tfvars e ajuste os valores conforme o ambiente.
#
# IMPORTANTE: NUNCA preencha "db_master_password" aqui nem em nenhum arquivo
# versionado. A senha master deve ser fornecida exclusivamente via variável de
# ambiente TF_VAR_db_master_password (execução local) ou GitHub Secrets (CI/CD).

aws_region  = "us-east-1"
environment = "production"

vpc_cidr              = "10.0.0.0/16"
private_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
availability_zones    = ["us-east-1a", "us-east-1b"]

# Substitua pelos CIDRs reais dos repositórios de compute (K8s) e da Lambda de autenticação.
k8s_cluster_cidr_blocks = ["10.1.0.0/16"]
auth_lambda_cidr_blocks = ["10.2.0.0/16"]

db_name     = "oficina"
db_username = "oficina_admin"
# db_master_password  -> NÃO definir aqui. Usar TF_VAR_db_master_password.

db_engine_version        = "16.4"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100

backup_retention_period = 7
backup_window           = "03:00-04:00"
maintenance_window      = "mon:04:30-mon:05:30"

multi_az = false
